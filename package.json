{
  "name": "web-translate",
  "description": "网页翻译助手：选中即问，翻译/解释/总结/改写，接入自有 OpenAI-compatible API",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test e2e",
    "icons": "node scripts/generate-icons.mjs",
    "demo": "node scripts/generate-demo-gif.mjs",
    "postinstall": "wxt prepare",
    "check": "npm run compile && npm test",
    "check:release": "npm run compile && npm test && npm run build && npm run build:firefox"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^20.11.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  }
}